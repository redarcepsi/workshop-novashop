# Copier ce fichier en .env pour surcharger les valeurs par défaut de docker-compose.yml
# Passerelle nginx, seul service publié. 0.0.0.0 = toutes les interfaces de la VM.
# Le jour J, restreindre au point d'accès du consortium : HTTP_BIND=<adresse de la VM sur ce réseau>.
# Pas 192.168.137.1 : c'est l'adresse du PC Hôte Windows, absente de la VM, et docker compose up échouerait.
HTTP_BIND=0.0.0.0
HTTP_PORT=8080

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

AUTH_DB_PASSWORD=auth_password
SHOP_DB_PASSWORD=shop_password
PAYMENT_DB_PASSWORD=payment_password

# Secret partagé entre auth-service (signature) et shop-service (vérification).
# Générer une vraie valeur : python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-secret-change-me-in-production-0123456789
JWT_EXPIRE_MINUTES=60

# Clé API du marchand PokéBling (code novashop) auprès de payment-service (shop-service l'envoie, payment-service n'en garde que le hash).
# Générer une vraie valeur : python3 -c "import secrets; print('sk_test_' + secrets.token_urlsafe(32))"
MERCHANT_API_KEY=sk_test_novashop_dev_only_change_me

# Comptes de démo leo@novashop.fr / ines@novashop.fr (mot de passe Demo1234), adresses gardées de NovaShop
SEED_DEMO_USERS=true

CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# --- Assistant documentaire des opérateurs (profil "ai") ---
# Modèles locaux servis par Ollama (gemma4:e4b : 7,5 milliards de paramètres, sous la limite de 8 du sujet)
LLM_MODEL=gemma4:e4b
EMBEDDING_MODEL=embeddinggemma:latest
# -1 : modèles jamais déchargés (sur processeur, recharger gemma4 prend plus de 3 minutes)
OLLAMA_KEEP_ALIVE=-1
# Mode réflexion de Gemma 4 : réponses plus justes (~10 s de plus sur GPU, bien davantage sur processeur,
# réflexion affichée en direct). false = plus rapide, conseillé si la VM n'a pas de GPU
LLM_THINK=true
# Clé partagée entre l'interface de chat (assistant-ui) et rag-service.
# Générer une vraie valeur : python3 -c "import secrets; print('rag_' + secrets.token_urlsafe(32))"
RAG_API_KEY=rag_dev_only_change_me
# Interface de chat publiée comme le site (même adresse que HTTP_BIND) : tout poste du réseau peut l'interroger.
# Décommenter pour la réserver à la VM elle-même :
#ASSISTANT_BIND=127.0.0.1
ASSISTANT_PORT=8083

# --- Supervision (profil "monitoring") : Prometheus, Loki et Grafana, dans leur propre compose sur la même VM ---
# Jeton exigé par metrics-gateway (Authorization: Bearer), à reporter dans prometheus.yml.
# Générer une vraie valeur : python3 -c "import secrets; print('metrics_' + secrets.token_urlsafe(32))"
METRICS_TOKEN=metrics_dev_only_change_me
# Passerelle des métriques sur la VM seule : Prometheus la joint par le réseau Docker novashop_monitoring-edge
# (cible metrics-gateway:80), ou par 127.0.0.1:9464 s'il est installé hors de Docker. Rien n'est publié sur le réseau
#METRICS_BIND=127.0.0.1
METRICS_PORT=9464
# Point d'envoi des journaux : le Loki de la supervision, branché sur le réseau novashop_monitoring-edge.
# Loki installé hors de Docker : http://<adresse-de-la-VM>:3100/loki/api/v1/push
LOKI_URL=http://loki:3100/loki/api/v1/push
